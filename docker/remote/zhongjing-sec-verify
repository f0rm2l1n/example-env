set -euo pipefail
source /usr/local/lib/zhongjing-sec/slot-common.sh
[ "${1:-}" = --slot ] || { echo "usage: zhongjing-sec-verify --slot SLOT_ID" >&2; exit 2; }
zhongjing_sec_load_slot "${2:-}"
zhongjing_sec_require_slot_files
for command_name in qemu-system-aarch64 timeout tee flock sha256sum; do
  command -v "$command_name" >/dev/null || { echo "missing command: $command_name" >&2; exit 2; }
done
(cd "$shared_dir" && sha256sum --check --strict ASSET_SHA256SUMS)
test -s "$shared_dir/payloads/vuln_misc.ko"
qemu-system-aarch64 -device help 2>/dev/null | grep -q 'virtio-net-device' \
  || { echo "missing qemu device: virtio-net-device" >&2; exit 2; }
echo "remote-verification=ok"
echo "slot_id=$slot_id"
echo "poc_optional=yes"