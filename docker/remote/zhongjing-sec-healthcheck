set -euo pipefail
[ "${1:-}" = --slot ] || { echo "usage: zhongjing-sec-healthcheck --slot SLOT_ID" >&2; exit 2; }
slot_id="${2:-}"
source /usr/local/lib/zhongjing-sec/slot-common.sh
zhongjing_sec_load_slot "$slot_id"
mkdir -p "$health_dir"
verify_log="$health_dir/verify.log"
status_file="$health_dir/healthcheck-status.txt"
verify_exit=0
zhongjing-sec-verify --slot "$slot_id" >"$verify_log" 2>&1 || verify_exit=$?
healthcheck=failed
[ "$verify_exit" -eq 0 ] && healthcheck=ok
cat > "$status_file" <<EOF_STATUS
slot_id=$slot_id
verify_exit=$verify_exit
workspace=/srv/zhongjing-sec
kernel_image=$kernel_image
rootfs_template=$rootfs_template
rootfs_cpio=$rootfs_cpio
module_ko=/srv/zhongjing-sec/shared/payloads/vuln_misc.ko
poc_in_dir=$poc_in_dir
healthcheck=$healthcheck
EOF_STATUS
cat "$status_file"
[ "$healthcheck" = ok ]
